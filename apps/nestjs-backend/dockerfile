# Stage 1: Production dependencies only (for runtime image)
FROM node:24.14.0-alpine AS deps

WORKDIR /app

# Align npm version with workspace engines
RUN npm install -g npm@11.11.0

# Copy dependency manifests only
COPY package.json package-lock.json turbo.json ./
COPY apps/nestjs-backend/package.json ./apps/nestjs-backend/
COPY packages/shared/package.json ./packages/shared/

# Omit optional deps so production image skips local SQLite driver stack
RUN npm ci --omit=dev --omit=optional --ignore-scripts

# Stage 2: Build stage with dev dependencies
FROM node:24.14.0-alpine AS builder

WORKDIR /app

RUN npm install -g npm@11.11.0 turbo

COPY package.json package-lock.json turbo.json ./
COPY apps/nestjs-backend/package.json ./apps/nestjs-backend/
COPY packages/shared/package.json ./packages/shared/

RUN npm ci --omit=optional

COPY packages/shared/ ./packages/shared/
COPY apps/nestjs-backend/ ./apps/nestjs-backend/

# Turbo resolves build order: shared -> backend
RUN turbo run build --filter=nestjs-backend...

# Stage 3: Production image
FROM node:24.14.0-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Runtime dependencies and built assets only
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/nestjs-backend/package.json ./
COPY --from=builder /app/apps/nestjs-backend/dist ./dist

EXPOSE $PORT

CMD ["node", "dist/src/main"]
