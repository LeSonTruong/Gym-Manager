{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "testRegex": "test/.*\\.e2e-spec\\.ts$",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
        "^.+\\.(t|j)s$": [
            "@swc/jest",
            {
                "jsc": {
                    "parser": {
                        "syntax": "typescript",
                        "decorators": true
                    },
                    "transform": {
                        "legacyDecorator": true,
                        "decoratorMetadata": true
                    },
                    "target": "es2022"
                },
                "module": {
                    "type": "commonjs",
                    "noInterop": true
                }
            }
        ]
    },
    "testEnvironment": "node"
}